{
  "name": "@adui/three",
  "version": "0.0.0",
  "description": "A small, lifecycle-focused Three.js scene host.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./controls": {
      "types": "./dist/controls.d.mts",
      "development": "./src/controls.ts",
      "import": "./dist/controls.mjs"
    },
    "./loaders": {
      "types": "./dist/loaders.d.mts",
      "development": "./src/loaders.ts",
      "import": "./dist/loaders.mjs"
    },
    "./interaction": {
      "types": "./dist/interaction.d.mts",
      "development": "./src/interaction.ts",
      "import": "./dist/interaction.mjs"
    },
    "./labels": {
      "types": "./dist/labels.d.mts",
      "development": "./src/labels.ts",
      "import": "./dist/labels.mjs"
    },
    "./animation": {
      "types": "./dist/animation.d.mts",
      "development": "./src/animation.ts",
      "import": "./dist/animation.mjs"
    },
    "./camera": {
      "types": "./dist/camera.d.mts",
      "development": "./src/camera.ts",
      "import": "./dist/camera.mjs"
    },
    "./postprocessing": {
      "types": "./dist/postprocessing.d.mts",
      "development": "./src/postprocessing.ts",
      "import": "./dist/postprocessing.mjs"
    },
    "./package.json": "./package.json",
    "./environment": {
      "types": "./dist/environment.d.mts",
      "development": "./src/environment.ts",
      "import": "./dist/environment.mjs"
    },
    "./textures": {
      "types": "./dist/textures.d.mts",
      "development": "./src/textures.ts",
      "import": "./dist/textures.mjs"
    },
    "./capture": {
      "types": "./dist/capture.d.mts",
      "development": "./src/capture.ts",
      "import": "./dist/capture.mjs"
    },
    "./geometry": {
      "types": "./dist/geometry.d.mts",
      "development": "./src/geometry.ts",
      "import": "./dist/geometry.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@types/three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "three": "0.187.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "three": ">=0.187.0 <0.188.0"
  }
}
