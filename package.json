{
  "name": "adui-three",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run docs:test && vp run docs:check && vp check && vp run -r test && vp run -r build",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:test": "node --test scripts/check-docs.test.mjs",
    "dev": "vp run @adui/three#build && vp run website#dev",
    "test:browser": "playwright test",
    "fixtures:models": "node scripts/generate-model-fixtures.mjs && vp fmt apps/website/public/models"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
